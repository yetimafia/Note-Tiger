# Settings for Note Tiger. Easiest: edit these in the control panel (http://localhost:3080).
# The installer copies this file to ".env".

# Discord bot token (Discord Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=

# --- Which AI writes the recaps and answers /ask ---
# Option A (smarter, costs a little): paste a Claude API key here.
# Option B (free, runs on this PC): leave it EMPTY and install Ollama (see README).
ANTHROPIC_API_KEY=

CLAUDE_MODEL=claude-sonnet-5-5
OLLAMA_MODEL=llama3.1:8b
OLLAMA_CONTEXT=16384

# Optional
CAMPAIGN_NAME=our Shadowrun campaign

# Speech-to-text always runs on this computer for free.
# If transcription is too slow, change this to onnx-community/whisper-base.en
WHISPER_MODEL=onnx-community/whisper-small.en
WHISPER_DTYPE=q8

DATA_DIR=./data

# Control panel
PANEL_PORT=3080
# Set to false to stop the panel opening in your browser on start
OPEN_PANEL=true

# Keep off-topic table talk out of recaps (still in the transcript, still eligible for Best Lines)
SEPARATE_TABLE_TALK=true

# Text channel for full transcripts (the recap goes where /session stop was used)
LOG_CHANNEL=logs

# Text channel for recaps
RECAP_CHANNEL=recaps

# Discord role(s) for the game master / storyteller (comma-separated)
GM_ROLE=Game Master, GM, Storyteller, DM

# Leave the opening "last time on..." recap out of the new recap
SKIP_OPENING_RECAP=true

# Player website (GitHub Pages, encrypted with the group password). Easiest to set up in Settings.
SITE_ENABLED=false
SITE_REPO=
GITHUB_TOKEN=
SITE_PASSWORD=
SITE_SHARE_PASSWORD=true
